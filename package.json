{
  "name": "@tyba-co/bottleneck",
  "version": "2.19.6",
  "description": "Distributed task scheduler and rate limiter",
  "main": "lib/index.js",
  "typings": "bottleneck.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mocha \"test/*.js\"",
    "test:local": "mocha \"test/*.js\"",
    "test:redis": "DATASTORE=ioredis mocha \"test/*.js\"",
    "test:cluster": "DATASTORE=ioredis mocha \"test/redis_cluster/*.js\"",
    "test:es5": "BUILD=es5 mocha \"test/*.js\"",
    "test:light": "BUILD=light mocha \"test/*.js\"",
    "build": "./scripts/build.sh",
    "test-all": "./scripts/test_all.sh",
    "compile": "npx tsc",
    "compile:watch": "npx tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tyba-co/bottleneck"
  },
  "publishConfig": {
    "@tyba-co:registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "async rate limiter",
    "rate limiter",
    "rate limiting",
    "async",
    "rate",
    "limiting",
    "limiter",
    "throttle",
    "throttling",
    "throttler",
    "load",
    "clustering"
  ],
  "author": {
    "name": "Org"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tyba-co/bottleneck"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.5.0",
    "@babel/preset-env": "^7.5.0",
    "@types/node": "^22.20.5",
    "ejs-cli": "github:SGrondin/ejs-cli#master",
    "ioredis": "^4.11.1",
    "jest-leak-detector": "^30.1.0",
    "mocha": "^11.8.0",
    "redis": "^2.8.0",
    "regenerator-runtime": "^0.12.1",
    "rollup": "^0.66.6",
    "rollup-plugin-babel": "^4.3.3",
    "rollup-plugin-commonjs": "^9.3.4",
    "rollup-plugin-json": "^3.1.0",
    "rollup-plugin-node-resolve": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
